config_version=5

[application]
config/name="Millionaire • Trending Edition"
run/main_scene="res://scenes/main.tscn"
boot_splash/show_image=false
boot_splash/minimum_display_time=0
boot_splash/bg_color=Color(0.012, 0.018, 0.055, 1)

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012, 0.018, 0.055, 1)
anti_aliasing/quality/msaa_3d=1

[audio]
driver/enable_input=false

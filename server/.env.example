# Gameplay needs no credentials. No .env file is automatically loaded.
PORT=8765
# Optional offline batch generation ONLY after explicit cost/frequency approval.
# Never place these in a Godot/web export.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TRIVIA_PAID_BATCH_APPROVAL=
# Explicit enablement value documented in docs/QUESTION_BANK.md; default is off.
TRIVIA_BATCH_LEDGER=server/cache/batch-attempts.json
